server {
    listen 8443 ssl default_server;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/nginx/fornost-tls.crt;
    ssl_certificate_key /etc/nginx/fornost-tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 10m;

    # Container addresses can change during a Podman restart/reinstall. Resolve
    # the service name at request time instead of pinning the first container IP.
    resolver ${FORNOST_DNS_RESOLVER} valid=2s ipv6=off;
    set $fornost_backend "http://fornost-grc-app:3000";

    location = / {
        return 302 ${FORNOST_BASE_PATH}/;
    }

    location = ${FORNOST_BASE_PATH} {
        return 301 ${FORNOST_BASE_PATH}/;
    }

    # Vinext writes base-prefixed asset URLs into the HTML while its standalone
    # server exposes the immutable bundles from /assets. Strip only this static
    # prefix at the proxy boundary; application and API routes keep their base path.
    location ${FORNOST_BASE_PATH}/assets/ {
        proxy_pass $fornost_backend/assets/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header oai-authenticated-user-email "";
        proxy_set_header oai-authenticated-user-full-name "";
        proxy_set_header oai-authenticated-user-full-name-encoding "";
    }

    location ${FORNOST_BASE_PATH}/ {
        proxy_pass $fornost_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header oai-authenticated-user-email "";
        proxy_set_header oai-authenticated-user-full-name "";
        proxy_set_header oai-authenticated-user-full-name-encoding "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8443 ssl default_server;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/nginx/fornost-tls.crt;
    ssl_certificate_key /etc/nginx/fornost-tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 10m;

    location = / {
        return 302 ${FORNOST_BASE_PATH}/;
    }

    location = ${FORNOST_BASE_PATH} {
        return 301 ${FORNOST_BASE_PATH}/;
    }

    # Vinext writes base-prefixed asset URLs into the HTML while its standalone
    # server exposes the immutable bundles from /assets. Strip only this static
    # prefix at the proxy boundary; application and API routes keep their base path.
    location ${FORNOST_BASE_PATH}/assets/ {
        proxy_pass http://fornost-grc-app:3000/assets/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ${FORNOST_BASE_PATH}/ {
        proxy_pass http://fornost-grc-app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Browser address: https://SERVER_IP:8443/fornost-grc/
FORNOST_BASE_PATH=/fornost-grc

# HTTPS listener exposed by the host. 8443 also works with rootless Podman/Docker.
FORNOST_HTTPS_PORT=8443

# Installer safety threshold. The compressed bundle expands into several GiB of container layers.
FORNOST_MIN_FREE_MB=8192

# Optional persistent host directory. Defaults to /var/lib/fornost-grc for root installs.
FORNOST_STATE_DIR=

# Optional: use an existing trusted PEM certificate and private key.
# Relative paths are resolved from the repository root. Configure both or neither.
# When left empty, the installer creates and reuses a persistent self-signed certificate.
FORNOST_TLS_CERT_FILE=
FORNOST_TLS_KEY_FILE=

# Optional DNS name to include in the generated self-signed certificate.
FORNOST_TLS_HOSTNAME=

# Optional 32+ character key for encrypting integration tokens at rest.
# When empty, the installer generates and preserves one under FORNOST_STATE_DIR.
FORNOST_SETTINGS_ENCRYPTION_KEY=

# Allow HTTP/private-network connector endpoints only for an explicitly managed on-prem deployment.
FORNOST_ALLOW_PRIVATE_CONNECTORS=false

# Keep false on-prem: browser-supplied platform identity headers must never be trusted.
FORNOST_TRUST_PLATFORM_IDENTITY=false

# The normal installer downloads the tested image matching this Git commit.
# Set true only for development or unsupported architectures/base paths.
FORNOST_BUILD_LOCAL=false

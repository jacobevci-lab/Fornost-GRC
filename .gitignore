# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
/.next/
/out/
/dist/
/.vinext/
*.tsbuildinfo

# misc
.DS_Store
*.pem
/.fornost-tls/
/.fornost-integration-state/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.onprem.example

# vercel
.vercel

# generated/runtime state
next-env.d.ts
/.wrangler/
/.sites-runtime/
/outputs/
/work/
